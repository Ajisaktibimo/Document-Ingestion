# ═══════════════════════════════════════════════════════════════════════════════
# Document-Ingestion — environment configuration
#
# QUICK-START PROFILES  (copy this file to .env and pick one profile)
# ──────────────────────────────────────────────────────────────────────────────
#  CPU-only   → keep everything as-is. No GPU required.
#  GPU (OCR)  → set DEVICE=gpu and the HARDWARE block below. Embeddings stay
#               on CPU. Good for machines with limited VRAM.
#  Full GPU   → set DEVICE=gpu AND flip all the GPU lines in each section.
#               Requires NVIDIA GPU with ≥8 GB VRAM (dense MoE model needs more).
# ═══════════════════════════════════════════════════════════════════════════════


# ── PROFILE ─────────────────────────────────────────────────────────────────
# "local" uses Ollama + local models. Change to "production" for vLLM.
BACKEND_PROFILE=local


# ── SERVICES (internal Docker network — do not change unless you rename containers) ──
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
POSTGRES_DSN=postgresql+asyncpg://docai:docai@postgres:5432/docai
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
OLLAMA_BASE_URL=http://ollama:11434
VLLM_BASE_URL=http://vllm-node:8000     # only used when BACKEND_PROFILE=production


# ── LLM ─────────────────────────────────────────────────────────────────────
# Ollama model tag — must be pulled inside the ollama container first.
# Small/fast: qwen3.5:0.8b   Balanced: qwen2.5:7b   Large: qwen2.5:32b
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=1000
OLLAMA_NUM_PREDICT=2048
OLLAMA_NUM_CTX=1024
OLLAMA_KEEP_ALIVE=5m

# Thinking / chain-of-thought per workload.
# OLLAMA_THINK is the global fallback.
# CHAT_OLLAMA_THINK overrides for chat (leave empty to inherit OLLAMA_THINK).
# INGESTION_OLLAMA_THINK overrides for document ingestion.
OLLAMA_THINK=True
CHAT_OLLAMA_THINK=False
INGESTION_OLLAMA_THINK=True

# MCP service has its own think overrides (same semantics as above).
MCP_OLLAMA_THINK=True
MCP_CHAT_OLLAMA_THINK=False
MCP_INGESTION_OLLAMA_THINK=True


# ── CAPTIONING ───────────────────────────────────────────────────────────────
# Tables and images are captioned via Ollama during ingestion.
# Leave CAPTION_VISION_MODEL empty to reuse OLLAMA_MODEL (must be multimodal).
# Set to a dedicated vision model tag if you want a separate model.
ENABLE_TABLE_CAPTIONING=True
ENABLE_IMAGE_CAPTIONING=True
CAPTION_VISION_MODEL=
MAX_IMAGES_PER_DOC=10
MAX_TABLES_PER_DOC=25
MAX_TABLE_MARKDOWN_CHARS=3000
INGESTION_MAX_CONCURRENT_TASKS=1


# ── HARDWARE / DOCKER GPU ────────────────────────────────────────────────────
# Controls whether Docker exposes a GPU to the api/mcp containers.
# This affects OCR (Docling/PaddleOCR/MinerU) but NOT embeddings by default.
# Embeddings have their own device settings further below.
#
# CPU-only  →  DEVICE=cpu   GPU_RESERVATION_COUNT=0
# GPU       →  DEVICE=gpu   GPU_RESERVATION_COUNT=all
DEVICE=gpu
GPU_RESERVATION_COUNT=all
NVIDIA_DRIVER=nvidia


# ── OCR / DOCUMENT PARSER ────────────────────────────────────────────────────
# Options: docling | paddle | marker | mineru | chandra
# "docling" is the recommended default (no extra install needed).
DOCUMENT_PARSER=docling

# PaddleOCR / MinerU / Chandra — only relevant if you switch DOCUMENT_PARSER.
MINERU_USE_GPU=True
MINERU_OUTPUT_DIR=data/mineru_output
CHANDRA_OCR_URL=http://chandra-node:8080


# ── DENSE EMBEDDING ──────────────────────────────────────────────────────────
# EMBEDDING_MODEL is the primary model selector. DENSE_EMBEDDING_CPU_MODEL
# is only used as fallback when EMBEDDING_MODEL is empty or "auto".
#
# The model is downloaded at image BUILD time into /opt/dense_cache (baked into
# the image layer). Changing these values requires a rebuild.
#
# ┌─ CPU ONNX (default — works on any machine, ~140 MB model) ─────────────────
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIM=768
DENSE_CACHE_DIR=/opt/dense_cache
DENSE_EMBEDDING_BACKEND=onnx
DENSE_EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_PROVIDERS=CPUExecutionProvider
DENSE_EMBEDDING_DEVICE_IDS=
DENSE_EMBEDDING_CPU_MODEL=nomic-ai/nomic-embed-text-v1.5
DENSE_MODEL_PATH=
DENSE_DOC_PREFIX=search_document:
DENSE_QUERY_PREFIX=search_query:
# └─────────────────────────────────────────────────────────────────────────────
#
# ┌─ GPU ONNX (same nomic-v1.5 model, inference on CUDA via onnxruntime-gpu) ──
# Requires onnxruntime-gpu installed in the image.
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# EMBEDDING_DIM=768
# DENSE_EMBEDDING_BACKEND=onnx
# DENSE_EMBEDDING_DEVICE=cuda
# DENSE_EMBEDDING_PROVIDERS=CUDAExecutionProvider
# └─────────────────────────────────────────────────────────────────────────────
#
# ┌─ GPU Torch — MoE model (best quality, needs ≥8 GB VRAM) ──────────────────
# Also set GPU_* vars in the "docker-compose.gpu.yml overrides" block below.
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe
# EMBEDDING_DIM=768
# DENSE_EMBEDDING_BACKEND=torch
# DENSE_EMBEDDING_DEVICE=cuda:0
# DENSE_EMBEDDING_PROVIDERS=
# └─────────────────────────────────────────────────────────────────────────────
DENSE_EMBEDDING_GPU_MODEL=nomic-ai/nomic-embed-text-v2-moe


# ── SPARSE EMBEDDING ─────────────────────────────────────────────────────────
# Model is fixed: Qdrant/bm42-all-minilm-l6-v2-attentions (BM42 sparse).
# Downloaded at BUILD time into /opt/sparse_cache.
#
# ┌─ CPU (default) ─────────────────────────────────────────────────────────────
SPARSE_CACHE_DIR=/opt/sparse_cache
SPARSE_EMBEDDING_DEVICE=cpu
SPARSE_EMBEDDING_PROVIDERS=CPUExecutionProvider
SPARSE_EMBEDDING_DEVICE_IDS=
# └─────────────────────────────────────────────────────────────────────────────
#
# ┌─ GPU ───────────────────────────────────────────────────────────────────────
# Requires onnxruntime-gpu installed in the image.
# SPARSE_EMBEDDING_DEVICE=cuda
# SPARSE_EMBEDDING_PROVIDERS=CUDAExecutionProvider
# └─────────────────────────────────────────────────────────────────────────────


# ── RERANKER ─────────────────────────────────────────────────────────────────
# Cross-encoder used after RRF fusion to re-score top candidates.
# Downloaded to HuggingFace cache (persisted in the hf_cache Docker volume).
# No rebuild needed when changing model.
#
# ┌─ CPU (default) ─────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_BACKEND=torch
RERANKER_DEVICE=cpu
RERANKER_MODEL_PATH=
# └─────────────────────────────────────────────────────────────────────────────
#
# ┌─ GPU ───────────────────────────────────────────────────────────────────────
# RERANKER_DEVICE=cuda:0
# └─────────────────────────────────────────────────────────────────────────────


# ── docker-compose.gpu.yml OVERRIDES ─────────────────────────────────────────
# These are read ONLY when you run:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up
# They override the dense embedding settings for the GPU compose profile.
# Leave commented when using docker-compose.yml alone.
#
# ┌─ GPU Torch — MoE (flip all three to enable GPU dense embedding) ────────────
# GPU_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe
# GPU_DENSE_EMBEDDING_BACKEND=torch
# GPU_DENSE_EMBEDDING_DEVICE=cuda:0
# └─────────────────────────────────────────────────────────────────────────────


# ── RETRIEVAL TUNING ─────────────────────────────────────────────────────────
# These control chunk sizes, recall depth, and score fusion weights.
# Safe to leave at defaults for most use cases.
CHUNK_PARENT_TOKENS=1500
CHUNK_CHILD_TOKENS=400
CHUNK_OVERLAP=0.20
DENSE_RECALL_K=50
SPARSE_RECALL_K=50
RRF_K=60
RRF_MERGED_K=20
RERANKER_OUTPUT_K=5
# Score fusion weights (must sum to 1.0): dense / sparse / reranker / recency
SCORE_ALPHA=0.40
SCORE_BETA=0.30
SCORE_GAMMA=0.20
SCORE_DELTA=0.10
DECAY_LAMBDA=0.01
DEDUP_THRESHOLD=0.85
VECTOR_PREFETCH_K=20
MIN_RELEVANCE_SCORE=0.10
RAG_CONTEXT_CHUNK_MAX_CHARS=2200
RAG_CONTEXT_TOTAL_MAX_CHARS=5000
# How long a stuck "processing" row is treated as stale before re-ingestion.
STALE_PROCESSING_THRESHOLD_SECONDS=600


# ── SESSION PERSISTENCE ───────────────────────────────────────────────────────
# Stores chat history in Postgres so conversations survive container restarts.
ENABLE_SESSION_PERSISTENCE=True
# Rolling window of messages always sent verbatim to the LLM.
SESSION_WINDOW_MESSAGES=20
# Periodically compress older messages into a summary.
# Off by default — needs a capable model to produce useful summaries.
ENABLE_SESSION_SUMMARIZATION=False
SUMMARIZATION_CADENCE_MESSAGES=10
SUMMARIZATION_OLLAMA_MODEL=       # leave empty to reuse OLLAMA_MODEL
SUMMARY_MAX_TOKENS=300
SESSION_USER_ID_COOKIE=docai_uid


# ── GRAPH SEARCH ─────────────────────────────────────────────────────────────
# Enables FalkorDB Cypher queries as an extra retrieval source.
# Keep False until the graph is populated (ingestion with graph writing enabled).
ENABLE_GRAPH_SEARCH=False
GRAPH_WRITE_CONF_MIN=0.85
GRAPH_SEARCH_TIMEOUT_SECONDS=10
# Schema-aware Cypher generation (feeds live node/rel schema into the prompt).
ENABLE_SCHEMA_AWARE_CYPHER=True
CYPHER_SCHEMA_CACHE_TTL_SECONDS=300
# Retry invalid Cypher up to N times (each retry = 1 extra LLM call).
ENABLE_CYPHER_SELF_HEALING=False
CYPHER_SELF_HEAL_MAX_ATTEMPTS=3


# ── NETWORKING ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MCP_HOST=0.0.0.0
MCP_PORT=8010
